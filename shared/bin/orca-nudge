#!/bin/bash
# orca-nudge — reset a stuck "working" spinner for an Orca pane.
#
# Orca's relay keeps per-pane agent state in memory and only updates it when a
# hook event arrives. An idle Claude session emits no events, so a state that
# went stale (missed SubagentStop, background task finishing after the last
# Stop, ...) spins forever. This tool re-sends the same SessionStart(resume)
# event the session itself would send, which makes the relay reset the pane's
# subagent roster / background-task flags and recompute the state.
#
# It only corrects state that is already wrong: the relay treats the event as
# "session resumed and idle", which is exactly what the guard below verifies
# before sending. See claude/skills/orca-relay/SKILL.md for the full playbook
# and docs/decisions/2026-08-orca-agent-hooks.md for background.
#
# Dead-pane fallback: the relay does not consume claude's SessionEnd, so a
# claude that dies while "working" leaves the spinner stuck with no process to
# read the pane env from. The relay-held shell left in that pane still carries
# ORCA_PANE_KEY / ORCA_AGENT_HOOK_ENDPOINT, so the same event can be sent from
# there — list mode shows such panes as status=dead with the shell's PID.
#
# Usage:
#   orca-nudge              list Claude sessions running inside Orca panes,
#                           plus dead panes (claude exited, shell survives)
#   orca-nudge <pid>        nudge the pane of that Claude process; for a dead
#                           pane, pass the pane shell's PID from list mode
#   orca-nudge --force <pid>  skip the "session must be idle" guard
#   orca-nudge --sweep      cron mode: reap dead panes the UI already closed
#                           (tab gone from ~/.orca/sessions — kills the shell
#                           so the pane cannot resurrect), and nudge the rest
#                           once (marker in ~/.cache/orca-nudge, dropped when
#                           a new claude appears in the pane)

set -u

MODE=""
if [ "${1:-}" = "--sweep" ]; then
  MODE=sweep
  shift
fi
FORCE=0
if [ "${1:-}" = "--force" ]; then
  FORCE=1
  shift
fi
TARGET_PID="${1:-}"

# ── Per-platform helpers ──

# All ORCA_*/CLAUDE_* vars of a process, one VAR=value per line.
proc_env() {
  local pid="$1"
  if [ -r "/proc/$pid/environ" ]; then
    tr '\0' '\n' < "/proc/$pid/environ"
  elif [ "$(uname)" = "Darwin" ]; then
    # `ps eww` appends "VAR=value" pairs after the command; keep only those.
    ps eww -o command= -p "$pid" 2>/dev/null | tr ' ' '\n' | grep -E '^[A-Z_]+='
  fi
}

env_var() { # $1: pid, $2: var name
  proc_env "$1" | grep -m1 "^$2=" | cut -d= -f2-
}

# Read one ORCA_AGENT_HOOK_* assignment from an endpoint.env file WITHOUT
# executing it. The path comes from another process's environment, so the file
# is parsed as data only — sourcing it would run attacker-controllable content
# in this shell, before the idle guard. Files not owned by the current user
# are ignored entirely.
endpoint_val() { # $1: endpoint file, $2: var name
  [ -n "$1" ] && [ -r "$1" ] || return 0
  local owner
  owner="$(stat -c %u "$1" 2>/dev/null || stat -f %u "$1" 2>/dev/null)"
  [ "$owner" = "$(id -u)" ] || return 0
  grep -m1 "^$2=" "$1" 2>/dev/null | cut -d= -f2-
}

# ── Process-tree helpers ──

# Same command-word match as list mode's pgrep pattern.
is_claude_proc() { # $1: pid
  ps -o args= -p "$1" 2>/dev/null | grep -qE '(^|/)claude( |$)'
}

# Print the PID of the first claude process in the subtree under $1 (excluding
# $1 itself); fail if there is none. A pane shell with no claude descendant is
# a dead pane — the session exited but the relay kept the shell (and its env).
claude_descendant() { # $1: pid
  local child
  for child in $(pgrep -P "$1" 2>/dev/null); do
    if is_claude_proc "$child"; then
      echo "$child"
      return 0
    fi
    claude_descendant "$child" && return 0
  done
  return 1
}

# ── Session status guard ──

# Claude Code writes <config_dir>/sessions/<pid>.json with a self-reported
# "status" field. Nudging is only safe when the session says it is idle —
# otherwise we would briefly show a genuinely working session as done.
session_status() { # $1: pid, $2: config dir ("" -> ~/.claude)
  local dir="${2:-$HOME/.claude}"
  local f="$dir/sessions/$1.json"
  [ -r "$f" ] || return 1
  grep -o '"status":"[^"]*"' "$f" | head -1 | cut -d'"' -f4
}

# ── Nudge one pane ──

nudge() { # $1: pid of the claude process
  local pid="$1"

  if ! kill -0 "$pid" 2>/dev/null; then
    echo "error: no such process: $pid" >&2
    echo "       If this was a claude PID whose process died, the relay-held shell in that" >&2
    echo "       pane still carries the pane key/endpoint — run \`orca-nudge\` (list mode)" >&2
    echo "       and nudge the PID shown as status=dead for that pane instead." >&2
    return 1
  fi

  local pane_key tab_id endpoint config_dir
  pane_key="$(env_var "$pid" ORCA_PANE_KEY)"
  tab_id="$(env_var "$pid" ORCA_TAB_ID)"
  endpoint="$(env_var "$pid" ORCA_AGENT_HOOK_ENDPOINT)"
  config_dir="$(env_var "$pid" CLAUDE_CONFIG_DIR)"

  if [ -z "$pane_key" ]; then
    echo "error: PID $pid has no ORCA_PANE_KEY — not an Orca pane session" >&2
    return 1
  fi

  # Dead-pane fallback: the target may be the pane's relay-held shell rather
  # than a claude process. That is legitimate only when its claude really
  # exited; with a live claude the session state file must be consulted, so
  # redirect to that PID. The shell inherited the same ORCA_* environment,
  # so everything below resolves identically.
  local dead=0 live_claude
  if ! is_claude_proc "$pid"; then
    if live_claude="$(claude_descendant "$pid")"; then
      echo "error: PID $pid is a pane shell with a live Claude session (PID $live_claude)." >&2
      echo "       Nudge that PID instead so the idle guard can check its session state." >&2
      return 1
    fi
    dead=1
  fi

  # Same resolution order as Orca's own claude-hook.sh: the endpoint file
  # (remote relay) wins, the TARGET process's env vars (local panes) are the
  # fallback. The caller's own ORCA_* env is never consulted — this script
  # usually runs inside another Orca pane whose port/token belong to a
  # different pane and possibly a different relay.
  local port token hook_env hook_version
  port="$(endpoint_val "$endpoint" ORCA_AGENT_HOOK_PORT)"
  token="$(endpoint_val "$endpoint" ORCA_AGENT_HOOK_TOKEN)"
  hook_env="$(endpoint_val "$endpoint" ORCA_AGENT_HOOK_ENV)"
  hook_version="$(endpoint_val "$endpoint" ORCA_AGENT_HOOK_VERSION)"
  [ -n "$port" ]         || port="$(env_var "$pid" ORCA_AGENT_HOOK_PORT)"
  [ -n "$token" ]        || token="$(env_var "$pid" ORCA_AGENT_HOOK_TOKEN)"
  [ -n "$hook_env" ]     || hook_env="$(env_var "$pid" ORCA_AGENT_HOOK_ENV)"
  [ -n "$hook_version" ] || hook_version="$(env_var "$pid" ORCA_AGENT_HOOK_VERSION)"

  if [ -z "$port" ] || [ -z "$token" ]; then
    echo "error: could not resolve Orca hook endpoint for PID $pid" >&2
    echo "       (endpoint file: ${endpoint:-none})" >&2
    return 1
  fi

  local status
  if [ "$dead" -eq 1 ]; then
    # No claude process means nothing in this pane can genuinely be working
    # (and no sessions/<pid>.json exists to consult) — the stuck spinner is
    # exactly the state this fallback resets, so the idle guard is moot.
    status="dead"
  else
    status="$(session_status "$pid" "$config_dir")" || status=""
    if [ "$FORCE" -ne 1 ]; then
      if [ -z "$status" ]; then
        echo "warn: no session state file for PID $pid — cannot verify it is idle." >&2
        echo "      Re-run with --force if you are sure the session is not working." >&2
        return 1
      fi
      if [ "$status" != "idle" ]; then
        echo "refused: session $pid reports status \"$status\" (not idle)." >&2
        echo "         A nudge would wrongly clear a live spinner. Use --force to override." >&2
        return 1
      fi
    fi
  fi

  # Re-check right before sending to shrink the race window. Live session:
  # idle may have flipped back to working. Dead pane: a new claude may have
  # just started there, and its own hooks now own the pane state — that check
  # holds even under --force, since a stale nudge could clear a live spinner.
  # Full atomicity is impossible (the relay has no conditional-reset API); the
  # residual race is documented in the orca-relay skill. Self-heals on the
  # session's next hook event either way.
  if [ "$dead" -eq 1 ]; then
    if live_claude="$(claude_descendant "$pid")"; then
      echo "refused: a Claude session (PID $live_claude) just started in this pane — aborted." >&2
      return 1
    fi
  elif [ "$FORCE" -ne 1 ]; then
    status="$(session_status "$pid" "$config_dir")" || status=""
    if [ "$status" != "idle" ]; then
      echo "refused: session $pid became \"${status:-unknown}\" just before sending — aborted." >&2
      return 1
    fi
  fi

  local http_code
  http_code="$(printf '%s' '{"hook_event_name":"SessionStart","source":"resume"}' | \
    curl -sS -o /dev/null -w '%{http_code}' -X POST "http://127.0.0.1:${port}/hook/claude" \
      --connect-timeout 0.5 --max-time 1.5 \
      -H "Content-Type: application/x-www-form-urlencoded" \
      -H "X-Orca-Agent-Hook-Token: ${token}" \
      --data-urlencode "paneKey=${pane_key}" \
      --data-urlencode "tabId=${tab_id:-${pane_key%%:*}}" \
      --data-urlencode "launchToken=$(env_var "$pid" ORCA_AGENT_LAUNCH_TOKEN)" \
      --data-urlencode "worktreeId=$(env_var "$pid" ORCA_WORKTREE_ID)" \
      --data-urlencode "env=${hook_env:-remote}" \
      --data-urlencode "version=${hook_version:-1}" \
      --data-urlencode "payload@-")" || {
    echo "error: could not reach relay on 127.0.0.1:${port}" >&2
    return 1
  }

  case "$http_code" in
    2*) echo "nudged PID $pid (pane ${pane_key%%:*}…, status: ${status:-unknown}) — relay accepted (HTTP $http_code)" ;;
    *)  echo "error: relay rejected the event (HTTP $http_code) — Orca may have changed its hook API" >&2
        return 1 ;;
  esac
}

# ── List mode ──

list_sessions() {
  local found=0 pid pane status config_dir
  # -x would miss wrapper-launched processes; match the command word instead.
  for pid in $(pgrep -u "$(id -un)" -f '(^|/)claude( |$)' 2>/dev/null); do
    pane="$(env_var "$pid" ORCA_PANE_KEY)" || true
    [ -n "$pane" ] || continue
    config_dir="$(env_var "$pid" CLAUDE_CONFIG_DIR)"
    status="$(session_status "$pid" "$config_dir")" || status="?"
    printf '%-10s status=%-8s pane=%s\n' "$pid" "$status" "$pane"
    found=1
  done
  # Dead panes: relay-held pane shells whose claude exited. The relay never
  # consumes claude's SessionEnd, so such a pane's spinner sticks — and the
  # shell keeps the pane env, making it a valid nudge target.
  local shell
  while read -r shell pane; do
    [ -n "${shell:-}" ] || continue
    printf '%-10s status=%-8s pane=%s (pane shell — claude exited)\n' "$shell" "dead" "$pane"
    found=1
  done < <(dead_panes)
  if [ "$found" -eq 0 ]; then
    echo "no Claude sessions running inside Orca panes (or not an Orca machine)"
  fi
}

# Emit one "shell_pid pane_key" line per dead pane: a relay-held pane shell
# (relay child with ORCA_PANE_KEY) that has no claude descendant.
dead_panes() {
  local relay shell pane
  for relay in $(pgrep -u "$(id -un)" -f 'relay\.js --detached' 2>/dev/null); do
    for shell in $(pgrep -P "$relay" 2>/dev/null); do
      pane="$(env_var "$shell" ORCA_PANE_KEY)"
      [ -n "$pane" ] || continue
      claude_descendant "$shell" >/dev/null && continue
      echo "$shell $pane"
    done
  done
}

# ── UI-abandoned pane detection ──

# Orca's app persists per-project tab layout in a server-side store; each tab
# carries the pane's remembered agent session id (the source of the app's
# auto-typed `claude --resume`). Closing a pane in the UI removes its tab from
# the store, but the relay keeps the pane's shell alive — and on the next
# project open the app re-adopts the orphan PTY, so the pane "resurrects".
# A dead pane whose tab id is gone from every store file is therefore residue
# the user already closed; reaping its shell is what makes UI-close stick.
# (Store schema v1, adoption behavior observed 2026-08-19 — see
# docs/decisions/2026-08-orca-dead-pane-sweep.md.)
ORCA_STORE_DIR="$HOME/.orca/sessions"
REAP_MIN_AGE_SEC="${ORCA_NUDGE_REAP_MIN_AGE:-600}"

# The store must look sane before its absence-of-a-tab means anything — if the
# app wiped or moved the store, refusing to reap is the safe failure mode.
store_ready() {
  grep -qs '"tabsByWorktreePath"' "$ORCA_STORE_DIR"/*.json 2>/dev/null
}

tab_in_store() { # $1: tab id
  grep -qs "$1" "$ORCA_STORE_DIR"/*.json 2>/dev/null
}

# A dead pane shell is reapable garbage only when ALL of these hold:
#   - the UI abandoned it (tab id absent from a sane store),
#   - nothing at all runs inside the shell (claude or otherwise),
#   - it is old enough that a just-created pane's store write cannot be
#     lagging behind (REAP_MIN_AGE_SEC).
# Intentionally kept panes are still listed in the store, so they never match.
reapable() { # $1: shell pid, $2: pane key
  store_ready || return 1
  tab_in_store "${2%%:*}" && return 1
  [ -z "$(pgrep -P "$1" 2>/dev/null)" ] || return 1
  local et
  et="$(ps -o etimes= -p "$1" 2>/dev/null | tr -d ' ')"
  [ -n "$et" ] && [ "$et" -ge "$REAP_MIN_AGE_SEC" ]
}

# ── Sweep mode (cron) ──

# Two-tier cleanup for dead panes. Panes the UI already closed are reaped
# (shell killed — see reapable() above); panes still in the UI get their
# spinner nudged exactly once. A per-pane marker file prevents the
# every-minute cron from re-sending forever (dead panes persist until their
# shell goes away); the marker is dropped when the shell dies or a new claude
# starts in the pane, so a session that dies "working" again is re-covered.
# Prints timestamped lines only when something happened — cron appends stdout
# to the sweep log, so a quiet sweep must stay silent.
SWEEP_STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/orca-nudge"

sweep() {
  local shell pane marker pid out
  mkdir -p "$SWEEP_STATE_DIR"
  for marker in "$SWEEP_STATE_DIR"/*.swept; do
    [ -e "$marker" ] || continue
    pid="${marker##*/}"; pid="${pid%%.*}"
    if ! kill -0 "$pid" 2>/dev/null || claude_descendant "$pid" >/dev/null; then
      rm -f "$marker"
    fi
  done
  while read -r shell pane; do
    [ -n "${shell:-}" ] || continue
    # UI-abandoned residue: kill the shell so the pane cannot resurrect.
    # Panes still present in the UI store fall through to the nudge below.
    if reapable "$shell" "$pane"; then
      kill -TERM "$shell" 2>/dev/null
      echo "[$(date '+%F %T')] sweep: reaped shell $shell (pane ${pane%%:*}… closed in UI, claude exited)"
      continue
    fi
    marker="$SWEEP_STATE_DIR/${shell}.${pane}.swept"
    [ -e "$marker" ] && continue
    if out="$(nudge "$shell" 2>&1)"; then
      : > "$marker"
      echo "[$(date '+%F %T')] sweep: $out"
    else
      echo "[$(date '+%F %T')] sweep: pane=$pane shell=$shell failed: $out"
    fi
  done < <(dead_panes)
  # Heartbeat for "did cron actually run?" without a log line per minute.
  touch "$SWEEP_STATE_DIR/.last-sweep"
}

if [ "$MODE" = "sweep" ]; then
  sweep
elif [ -z "$TARGET_PID" ]; then
  list_sessions
else
  nudge "$TARGET_PID"
fi
